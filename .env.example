# JARVIS Environment Variables Example
# Copy this file to .env and adjust values for your environment.

JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOCAL_HOST=127.0.0.1
JARVIS_LOCAL_PORT=8765

# Optional Cloud API Integration
JARVIS_CLOUD_API_URL=https://api.jarvis.local
JARVIS_DEVICE_ID=

# Optional LLM Model Provider Credentials
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
