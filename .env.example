# JARVIS Unified Monorepo Environment Variables
# Copy this file to .env and adjust values for your environment.

# --- Agent Backend Server Settings ---
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_LOCAL_HOST=127.0.0.1
JARVIS_LOCAL_PORT=8765

# --- Security & Authentication (Optional explicit overrides; auto-generated in ~/.jarvis/credentials.json if empty) ---
JARVIS_API_AUTH_TOKEN=
JARVIS_APPROVAL_SECRET_KEY=

# --- React Desktop Frontend Settings ---
VITE_JARVIS_API_URL=http://127.0.0.1:8765/api/v1
VITE_JARVIS_WS_URL=ws://127.0.0.1:8765/api/v1/ws
VITE_JARVIS_API_AUTH_TOKEN=

# --- Optional Cloud & LLM Provider Integrations ---
JARVIS_CLOUD_API_URL=https://api.jarvis.local
JARVIS_DEVICE_ID=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
